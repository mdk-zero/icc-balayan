# FTP login for `npm run deploy`. Copy this file to deploy.env (git ignores
# it) and fill it in. Write each value as it is, without quotes. The README's
# "Deploying with one command" section explains where each one comes from.

# The server's own name, as on cPanel's Server Information page.
# ftp.iccbalayan.edu.ph reaches the same server but fails the certificate
# check, because the certificate is the host's (*.websitewelcome.com).
FTP_HOST=arosa.websitewelcome.com
# The FTP account's full username, for example deploy@iccbalayan.edu.ph.
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21
# The site's folder, counted from the folder the FTP account opens in. Keep
# the dot for an FTP account whose directory is public_html itself. Use
# public_html when logging in with the main cPanel account.
FTP_DIR=.
